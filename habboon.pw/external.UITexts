  "halloween.contest.mine.desc": "Enter the look you're wearing now. Other Habbos vote in anonymous duels, and the spookiest looks climb the leaderboard.",
  "halloween.contest.mine.enter": "Enter this look",
  "halloween.contest.mine.rank": "Rank #%rank% of %total%",
  "halloween.contest.mine.update": "Update my look",
