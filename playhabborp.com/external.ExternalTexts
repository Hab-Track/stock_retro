  "quests.nov24_gladiator.1731332659011.desc": "Let's find some snacks",
  "quests.nov24_gladiator.1731332659011.hint": "Find some food to take care of your hunger.",
  "quests.nov24_gladiator.1731332659011.name": "Emperors also eat",
