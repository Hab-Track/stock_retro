  "quests.test24.1723121540769.name": "Para Kazancı",
  "quests.test24.1723187732163.desc": "PARA BIRIMI 200",
  "quests.test24.1723187732163.name": "HARCAMA PARA BIRIMI",
  "quests.test24.1723187857222.desc": "Mağazadan Küçük Havuz Paketi Satın Alın",
  "quests.tracker.lessinfo": "Yakından ipucu",
  "quests.trading.name": "Ticaret kartı",
  "quests.val12.title": "Sevgililer Günü Görevi Takvimi",
  "quests.val12_1.1326806590698.completed": "Hey seksi, ne oluyor? ;)",
  "quests.val12_1.1326806590698.desc": "Sevgililer Günü için cesur bir yeni saç modeli edin!",
  "quests.val12_1.1326806590698.hint": "Basit ol, kestane ol! Odanıza gidin, Mabbo'ya tıklayarak Görünümleri Değiştir menüsünü açın. Doğru saç rengini arayın ve saklayın.",
  "quests.val12_1.1326806590698.name": "Gerçek Aşkı Bul",
  "quests.val12_1.1326807570952.completed": "Çok zarifsin!",
  "quests.val12_1.1326807570952.desc": "Eski stiller en iyisi! Bir papyon ya da inci kolye deneyin!",
  "quests.val12_1.1326807570952.hint": "Mabbo'nuzda Görünümleri Değiştir menüsünü açmak için tıklayın, doğru aksesuarı (papyon, kravat veya inci kolye) arayın ve takın.",
  "quests.val12_1.1326807570952.name": "Gerçek Aşkı Bul II",
  "quests.val12_1.1327412775782.completed": "Zarif!",
  "quests.val12_1.1327412775782.desc": "BONUS: Her zaman siyah üzerine bahis yapın!",
  "quests.val12_1.1327412775782.hint": "Bu ise yüksek lisans kullanıcıları için! Kıyafet rengini değiştir: Siyahtan daha şık bir şey yoktur. Üstünü, pantolonunuzu/eteğinizi ve ayakkabılarınızı siyah'a değiştirin.",
  "quests.val12_1.1327412775782.name": "Gerçek Aşk - Bonus",
  "quests.val12_1.1327412844688.completed": "Yepyenisin! Çalışıyor mu?",
  "quests.val12_1.1327412844688.desc": "Şimdi bunu dünyaya gösterme zamanı!",
  "quests.val12_1.1327412844688.hint": "Yeni görünümünüzü test etmek için başka bir Mabbo'nun odasına git - tabii ki boş odaya değil! İpucu: 'aşk' kelimesiyle etiketlenmiş odaları arayabilirsiniz.",
  "quests.val12_1.1327412844688.name": "Gerçek aşkı Bul III",
  "quests.val12_1.1327414538662.completed": "Peki? Yeni görünüşünle başlarını çevirdin mi yoksa gözünü devirdin mi?",
  "quests.val12_1.1327414538662.desc": "Şimdi yeni görünümünüzü sergileme zamanı!",
  "quests.val12_1.1327414538662.hint": "Yeni görünümünüzü test etmek için başka bir Mabbo'nun odasına gidin! Odada en az bir başka Mabbo olmalı. Bir Oda Hopper Asansörü bulun ve atlayın!",
  "quests.val12_1.1327414538662.name": "Gerçek Aşkı Bul III",
  "quests.val12_1.name": "1. Gün",
  "quests.val12_10.1328047081178.completed": "Para ağaçlarda büyümez ama aşk... Elmalar kesinlikle yapar, portakal da öyle. Aşk çanlarını duydun mu? Yoksa daha çok çimento mikseriyle yeniden düzenlenmiş şüpheli speed metal miydi?",
  "quests.val12_10.1328047081178.desc": "Üzüm Süzüğünden Duydum...",
  "quests.val12_10.1328047081178.hint": "Mabbo'nuzu Vines Of Love Furni'ye yerleştirin ve randevunuza yanına oturmasını söyleyin.",
  "quests.val12_10.1328047081178.name": "Yasak Meyve I",
  "quests.val12_10.1328047325635.completed": "Tamam! Ah, eğer sadece tokat atsalar, başka bir yaklaşım denemen gerekebilir...",
  "quests.val12_10.1328047325635.desc": "Niyetlerini gizleme...",
  "quests.val12_10.1328047325635.hint": "Gerçek niyetlerini ortaya çıkar! Hedefinize gerçekten neye ihtiyacınız olduğunu söyleyin! Peki ya bir randevuya?",
  "quests.val12_10.1328047325635.name": "Yasak Meyve II",
  "quests.val12_10.1328047417557.completed": "Uhuh, hep sarsıldın!",
  "quests.val12_10.1328047417557.desc": "Henüz net değil mi? Hedefin biraz sarsılması gerekiyor!",
  "quests.val12_10.1328047417557.hint": "Öpüşme Kabini Furni'ye gir ve randevunu seninle gelmesi için çağır ve... Ne olacağını gör!",
  "quests.val12_10.1328047417557.name": "Yasak Meyve III",
  "quests.val12_10.1328047609332.completed": "Birbirinize gerçekten açılıyorsunuz. Çok güzel. Unutmayın, güven iki yönlü bir yoldur; bolca çukur, trafik bekçileri ve ara sıra sokak köpekleri var. Genellikle bir serseri de vardır ama ondan uzak durmak en iyisi.",
  "quests.val12_10.1328047609332.desc": "Bahse girerim bu onları sarsmıştır!",
  "quests.val12_10.1328047609332.hint": "Randevunun sesini duyalım, duygudan titreyerek, şimdi ne hissettiğini anlatır!",
  "quests.val12_10.1328047609332.name": "Yasak Meyve IV",
  "quests.val12_10.name": "10. Gün",
  "quests.val12_11.1328047974832.completed": "Sana bak! O kadar parlaksın ki gözlük takmam gerekiyor! Güneş gözlükleri ayrıca kanlı gözleri, pembe gözleri ve beyansız kazançları gizlemek için de harika!",
  "quests.val12_11.1328047974832.desc": "Burada hava ısınıyor! Kendine seksi bir yaz tarzı al...",
  "quests.val12_11.1328047974832.hint": "Mabbo'ya tıklayın ve ardından 'Görünüşü Değiştir'. Sarı bir saç rengi, şık güneş gözlükleri ve tamamen bronzlaşan bir saç seç:o",
  "quests.val12_11.1328047974832.name": "Hot and Heavy I",
  "quests.val12_11.1328048208698.completed": "Şimdi herkes biliyor! Bu da kötü bir şey olursa polisin aradığı ilk kişi olacağınız anlamına geliyor. Kimse aşkın kolay olduğunu söylemedi...",
  "quests.val12_11.1328048208698.desc": "Birine aşık mı oldun? Her yere yazın!",
  "quests.val12_11.1328048208698.hint": "Aşkınızı ilan edin! Birlikte olmak istediğiniz Mabbo'nun adını sloganınıza ekleyin!",
  "quests.val12_11.1328048208698.name": "Hot & Heavy III",
  "quests.val12_11.1328048287948.completed": "Parla! Yıldız gibi parla! Yıldız gibi parlıyorsun!",
  "quests.val12_11.1328048287948.desc": "Daha dikkat çekici olmalısın!",
  "quests.val12_11.1328048287948.hint": "Mağazanın Pixel bölümünden Özel Efektler için kontrol edin ve parlak olanı seçin. Mabbo'nuza tıklayın ve doğru olanı etkinleştirmek için \"Efektlerim\"e tıklayın.",
  "quests.val12_11.1328048287948.name": "Hot & Heavy II",
  "quests.val12_11.1328048633937.completed": "Ateşin, ateşin, doğan bir şey değilsin... Aslında, bence aşık hastasın, çok geç olmadan bir doktora (ya da Patch Adams'a) görünmek isteyebilirsin.",
  "quests.val12_11.1328048633937.desc": "Sıcaklığınızı kontrol ederek ne kadar sıcak olduğunuzu kanıtlayın.",
  "quests.val12_11.1328048633937.hint": "Bir Termometre Furni bul, yanına Mabbo'nu koy, orada sıcaklığın nasıl yükseldiğini gör...",
  "quests.val12_11.1328048633937.name": "Sıcak ve Ağır! IV",
  "quests.val12_11.name": "11. Gün",
  "quests.val12_12.1328085770895.completed": "Vay, genç bir Vanilla Ice'ın ateşi ve tutkusu var. Şimdi gerçekten deneyelim!",
  "quests.val12_12.1328085770895.desc": "Kendine güvenmen lazım! Ama ilk antrenman...",
  "quests.val12_12.1328085770895.hint": "Şöyle de: \"Nasılsın?\"",
  "quests.val12_12.1328085770895.name": "Doğrudan Olun I",
  "quests.val12_12.1328086020777.completed": "Ah evet! Gösterişli kıyafetlerinizi gösterin ve dans pistine sahip olun!",
  "quests.val12_12.1328086020777.desc": "Et pazarına gitmeye hazır mısın?",
  "quests.val12_12.1328086020777.hint": "En az 5 Mabbo'nun olduğu bir disko odası bul ve dans etmeye başla.",
  "quests.val12_12.1328086020777.name": "Be Direct II",
  "quests.val12_12.1328086174512.completed": "Ne kadar çekici bir çekicilik!",
  "quests.val12_12.1328086174512.desc": "Hareketlerinde bir şeyler...",
  "quests.val12_12.1328086174512.hint": "En az 5 kullanıcıyı yanınızda bulundurun ve onlardan birine arkadaşlık isteği gönderin.",
  "quests.val12_12.1328086174512.name": "Be Direct III",
  "quests.val12_12.1328086232488.completed": "Ne? Daha fazlasını mı istiyorsun? Sen tam bir oyuncusun.",
  "quests.val12_12.1328086232488.desc": "Ne kadar çok olursa o kadar iyi!",
  "quests.val12_12.1328086232488.hint": "Bir buluşma yeterli değil. Daha ileri düşün... Odadaki başka bir Mabbo'ya bir arkadaşlık isteği daha gönder.",
  "quests.val12_12.1328086232488.name": "Be Direct IV",
  "quests.val12_12.name": "12. Gün",
  "quests.val12_13.1328086329456.completed": "Kalbinin attığını görebiliyorum! Ayrıca, böbrek taşınız olabilir diye düşünüyorum.",
  "quests.val12_13.1328086329456.desc": "Vücudunun gerçekten ne düşündüğünü ortaya çıkarmasına izin ver...",
  "quests.val12_13.1328086329456.hint": "Sevgililer Günü X-Ray Makinesine gir ve ne olacağını gör...",
  "quests.val12_13.1328086329456.name": "Beden Dili I",
  "quests.val12_13.1328086604766.completed": "Oh oh tamam! Daha fazlasını bilmek istemiyoruz...",
  "quests.val12_13.1328086604766.desc": "İyi gidiyor! Zaten bir lakabınız var mı?",
  "quests.val12_13.1328086604766.hint": "Randevunuza hangi lakabı verdiğini sorun.",
  "quests.val12_13.1328086604766.name": "Beden Dili II",
  "quests.val12_13.1328086759099.completed": "Muhtemelen acil servise gitmelisin...",
  "quests.val12_13.1328086759099.desc": "HC İÇİN BONUS - Birisi kalbini çalarsa...",
  "quests.val12_13.1328086759099.hint": "Sadece bir gecelik olduğunu sanmıştın ama biri kalbini ve pantolonunu çalmayı başarmış. Göğsündeki deliği gösterecek şekilde kıyafetlerini değiştir.",
  "quests.val12_13.1328086759099.name": "Beden Dili III",
  "quests.val12_13.name": "13. Gün",
  "quests.val12_14.1328086930501.completed": "O gece havada bir şey vardı. Yıldızlar parlaktı, Fernando...",
  "quests.val12_14.1328086930501.desc": "Şimdi farklı görünüyorsun... Yıldızlara bakmak ister misin?",
  "quests.val12_14.1328086930501.hint": "Çift kişilik bir yatak bulun, randevunuzla birlikte uzanın ve en az bir dakika gökyüzüne bakın.",
  "quests.val12_14.1328086930501.name": "Bütün Gece Boyunca I",
  "quests.val12_14.1328087076582.completed": "Ne kadar çok olursa o kadar iyi ;) Umarız bu Sevgililer Günü'nde gerçek aşkı bulmuşsunuzdur ya da en azından cüzdanınızı çalmaya çalışmayan birini. Unutmayın: Gerçek aşk sonsuza kadar sürebilir, ama hamam böcekleri de öyle!",
  "quests.val12_14.1328087076582.desc": "Yıldızlar havalı ama şimdi parti zamanı!",
  "quests.val12_14.1328087076582.hint": "Tüm önceki partnerlerinizi - en az 5 Mabbo - kendi odanıza davet edin ve dans etmeye başlayın.",
  "quests.val12_14.1328087076582.name": "Tüm Gece II",
  "quests.val12_14.name": "14. Gün",
  "quests.val12_2.1327417113969.completed": "Arkadaş edinmek başta göz korkutucu olabilir ama alışırsın ;)",
  "quests.val12_2.1327417113969.desc": "Dikkatinizi çeken bir Mabbo ile arkadaş olun.",
  "quests.val12_2.1327417113969.hint": "Başka bir kullanıcı odasına gidin, gerçekten sevdiğiniz Mabbo'yu bul, yanında kal ve el sallayın. İpuçları: 'love' kelimesiyle etiketlenmiş odaları arayın.",
  "quests.val12_2.1327417113969.name": "İlk deneme I",
  "quests.val12_2.1327417562825.completed": "Harikaydı!",
  "quests.val12_2.1327417562825.desc": "Potansiyel bir arkadaşınıza kendinizi tanıtın.",
  "quests.val12_2.1327417562825.hint": "Biriyle tartışma başlatmanın en temel yolu nedir? Mabbo'nuzu başka bir tanesinin yanına koyun ve kendinizi tanıtın!",
  "quests.val12_2.1327417562825.name": "İlk Deneme II",
  "quests.val12_2.1327419612190.completed": "Bitti!",
  "quests.val12_2.1327419612190.desc": "Cesur olun: Yeni arkadaşınıza bir arkadaşlık isteği gönderin!",
  "quests.val12_2.1327419612190.hint": "Odadaki en çok sevdiğiniz Mabbo'ya ve başının üstündeki \"Arkadaş Ol\" butonuna tıklayın.",
  "quests.val12_2.1327419612190.name": "İlk Deneme III",
  "quests.val12_2.name": "2. Gün",
  "quests.val12_3.1327488831969.completed": "En iyisi, hiç söylemediğinde söylersin.",
  "quests.val12_3.1327488831969.desc": "Konuşmaya utangaç mısın? Düşüncelerinizi ona kelimelersiz söyleyin.",
  "quests.val12_3.1327488831969.hint": "Arkadaşınızın yanında kalın, Mabbo'nuza, ardından İşaretler'e tıklayın ve sevgi dolu duygularınızı ifade edecek doğru olanı seçin.",
  "quests.val12_3.1327488831969.name": "Love Contact I",
  "quests.val12_3.1327489066644.completed": "Bazen kelimeler araya girer...",
  "quests.val12_3.1327489066644.desc": "Ve tam tersi... İlk işarette aşk!",
  "quests.val12_3.1327489066644.hint": "Diğer Mabbo da senin için aynısını yapacak: arkadaşın sana bir aşk işareti göstermeli.",
  "quests.val12_3.1327489066644.name": "Love contact II",
  "quests.val12_3.name": "3. Gün",
  "quests.val12_4.1328018402503.completed": "Pürüzsüz... Sanırım hava maviye döndü.",
  "quests.val12_4.1328018402503.desc": "Sevgiline iltifat et, şiirsel ol!",
  "quests.val12_4.1328018402503.hint": "Favori Mabbo'nun yanında kal ve onu tamamlayacak doğru kelimeleri bulmaya çalış.",
  "quests.val12_4.1328018402503.name": "Hamlenizi Yapın I",
  "quests.val12_4.1328018538350.completed": "Flynn gibi içeri girdin!",
  "quests.val12_4.1328018538350.desc": "Sevgilisiyle oturup duygularını konuş.",
  "quests.val12_4.1328018538350.hint": "Sevgilinizi yeni Sevgililer Günü kanepesinde sizinle oturmaya davet edin ve onu büyünüze bırakın.",
  "quests.val12_4.1328018538350.name": "Hamlenizi Yapın II",
  "quests.val12_4.name": "4. Gün",
  "quests.val12_5.1328042186100.completed": "Güzel kokuyor...",
  "quests.val12_5.1328042186100.desc": "Aşkını bir çiçekle ilan et!",
  "quests.val12_5.1328042186100.hint": "Bir çiçek bulun, üzerine çift tıklayarak onu seçin ve favori Mabbo'ya onun üzerine tıklayarak ve başının üzerindeki \"Eşya Verme\" butonuna verin.",
  "quests.val12_5.1328042186100.name": "Tek ve Tek Ben",
  "quests.val12_5.1328179432493.completed": "Aman Tanrım!! Tutkunun sıcaklığı Plasto'yu eritebilir!",
  "quests.val12_5.1328179432493.desc": "BONUS HC: Öpücükle mühürlendi.",
  "quests.val12_5.1328179432493.hint": "Anlaşmayı kapatmak için partnerinize bir öpücük gönderin! Mabbo'ya ve \"Eylemler\"e tıklayın. O zaman seç, öpücük!",
  "quests.val12_5.1328179432493.name": "Tek ve Tek V",
  "quests.val12_5.1328179744190.completed": "Kendini kaptırma!",
  "quests.val12_5.1328179744190.desc": "İki kişilik masayı kurun ve sevgilinizi sessiz bir içkiye davet edin.",
  "quests.val12_5.1328179744190.hint": "Bu görevi tamamlamak için Sevgililer Günü Masası'na çift tıklayın.",
  "quests.val12_5.1328179744190.name": "Tek ve Tek II",
  "quests.val12_5.1328179995571.completed": "Tamamen yalnızsın... Sanırım biraz arkadaşlığa ihtiyacın var.",
  "quests.val12_5.1328179995571.desc": "Lurve Feneri'nin altına gir ve dans etmeye başla!",
  "quests.val12_5.1328179995571.hint": "Bir Lurve Feneri'ni bulun, altında dans etmeye başlayın ve üzerine çift tıklayın.",
  "quests.val12_5.1328179995571.name": "Tek ve Tek III",
  "quests.val12_5.1328180232264.completed": "Bu cennette (ya da Idaho'da) yapılmış bir eşleşme!",
  "quests.val12_5.1328180232264.desc": "Sevgilini seninle dans etmeye davet et.",
  "quests.val12_5.1328180232264.hint": "Sevgilinize en az bir dakika boyunca Lurve Feneri'nin altında hemen yanınızda (solunda) dans etmeye gelmesini söyleyin.",
  "quests.val12_5.1328180232264.name": "Tek ve Tek IV",
  "quests.val12_5.name": "5. Gün",
  "quests.val12_6.1328043806397.completed": "Vay, biri ateş konusunda seviye atladı! Rawr!",
  "quests.val12_6.1328043806397.desc": "Saçın biraz dağınık görünüyor - değişiklik zamanı!",
  "quests.val12_6.1328043806397.hint": "HC saç uzatmaları veya herkes için kısa saç uzantıları, hemen saç kesiminizi değiştirin ve görselde görünen iki saç kesiminden birini seçin!",
  "quests.val12_6.1328043806397.name": "Aşk Saçta",
  "quests.val12_6.name": "6. Gün",
  "quests.val12_7.1328044427325.completed": "Henüz kimseyi bulamadım mı? Tekrar dene! Er ya da geç birini bulacaksın...",
  "quests.val12_7.1328044427325.desc": "Bugün aşkı bulmak için mükemmel bir gün!",
  "quests.val12_7.1328044427325.hint": "En az bir Mabbo daha olan başka bir odaya git ve bir partner bulmaya çalış. İpucu: Oda Hopper Perdelerini kullanmayı deneyin!",
  "quests.val12_7.1328044427325.name": "SONRAKI! I",
  "quests.val12_7.1328044628754.completed": "İçeride yeterince insan yok...",
  "quests.val12_7.1328044628754.desc": "Görünüşe göre bir partner bulmak o kadar kolay değil... Tekrar dene!",
  "quests.val12_7.1328044628754.hint": "En az 2 başka Mabbo'nun olduğu 5 farklı Mabbo odasını ziyaret et.",
  "quests.val12_7.1328044628754.name": "SONRAKI! II",
  "quests.val12_7.1328044727908.completed": "Bir gün, iyi olanı bulacaksın.",
  "quests.val12_7.1328044727908.desc": "Doğru olanı bulamadın mı? Devam edelim!",
  "quests.val12_7.1328044727908.hint": "En az 5 Mabbo bulunan 10 başka Mabbo odasına git.",
  "quests.val12_7.1328044727908.name": "SONRAKI! III",
  "quests.val12_7.1328181784728.completed": "Ne kadar uyumlu bir çift! Çok koordine!",
