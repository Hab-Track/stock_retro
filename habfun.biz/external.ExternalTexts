  "landing.view.suncity19craft.body": "Trashbot Jr. üretim masasını farklı malzemelerle birlikte kullanarak Sunlight City kıyafetleri ve mobilyaları oluşturun!",
  "landing.view.suncity19craft.button": "El işi yap!",
