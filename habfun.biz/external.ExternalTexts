  "landing.view.animalday.button": "Hemen gözat",
  "landing.view.animalday.header": "Evcil hayvanlarda %20 İndirim!",
  "landing.view.apr16_rare1.body": "The smoke machine EVERY Mabbo wants is here. This classic rare is a vitally important part of Mabbo history - don't miss it!",
