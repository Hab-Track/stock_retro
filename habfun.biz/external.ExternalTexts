  "quests.easter25_egghunt.1742912087454.hint": "Güzel ve sıcak hava, arkadaşlarınız veya ailenizle güneşin tadını çıkarmayı gerektirir. Yemeyi ve su içmeyi unutmayın!",
  "quests.easter25_egghunt.1742912087454.name": "Güneşli Gün Tavşanı",
  "quests.easter25_egghunt.1742912164816.completed": "Harika, bu Büyülü Yumurta!",
  "quests.easter25_egghunt.1742912164816.desc": "Otelde harika, mistik bir yumurta arayın!",
  "quests.easter25_egghunt.1742912164816.hint": "Paskalya yumurtaları aramadan bir Paskalya hazine avı ne olurdu?",
  "quests.easter25_egghunt.1742912164816.name": "Paskalya Büyüsü",
  "quests.easter25_egghunt.1742972669586.completed": "Bu bir Bunny Chia evcil hayvanı!",
  "quests.easter25_egghunt.1742972669586.desc": "Şimdiye kadarki en sevimli bahçe dekorasyonunu arayın!",
  "quests.easter25_egghunt.1742972669586.hint": "Tavşan mı? Yoksa bitki örtüsü mü?",
  "quests.easter25_egghunt.1742972669586.name": "Bitki mi, fauna mı?",
  "quests.easter25_egghunt.1742973901243.completed": "Devasa Yumurta Sepetini buldun! Belki senin için de yumurta vardır!",
  "quests.easter25_egghunt.1742973901243.desc": "Birisi devasa bir paskalya yumurtası koleksiyonu topladı!",
  "quests.easter25_egghunt.1742973901243.hint": "Bu kadar devasa miktarda yumurta nerede bulunabilirdi ve onları taşımak için ne kullanılabilirdi ki?",
  "quests.easter25_egghunt.1742973901243.name": "Devasa Bir Kazanım",
  "quests.easter25_egghunt.1742978993372.completed": "Harika! Hangisi önce geldi, tavuk mu yumurta mı?",
  "quests.easter25_egghunt.1742978993372.desc": "Daha fazla yumurta nerede boyayabiliriz?",
  "quests.easter25_egghunt.1742978993372.hint": "Belki çiftlik cevaplar verir!",
  "quests.easter25_egghunt.1742978993372.name": "Yumurtaların Kaynağı",
  "quests.easter25_egghunt.1742982860591.completed": "Vay, görkemli bir Altın Yumurta!",
  "quests.easter25_egghunt.1742982860591.desc": "Hiçbir şeye benzemeyen bir yumurta bul!",
  "quests.easter25_egghunt.1742982860591.hint": "Bazı yumurtaların uzun zamandır var olduğu, bazılarının ise en yetenekli zanaatkârlar tarafından yapıldığı söylenir.",
  "quests.easter25_egghunt.1742982860591.name": "Parıldayan Dev",
  "quests.easter25_egghunt.1742984632052.completed": "Güzel, Tavşan Halı'nı buldun!",
  "quests.easter25_egghunt.1742984632052.desc": "Yastıklı bir tavşan arayın!",
  "quests.easter25_egghunt.1742984632052.hint": "Bazen gizemler göz ardı edilir, ama cevaplar ayaklarınızın hemen altında bulunabilir!",
  "quests.easter25_egghunt.1742984632052.name": "Açılan Tavşan",
  "quests.easter25_egghunt.name": "Paskalya Hazine Avı",
  "quests.festabrasil_25.1746710928084.chaincaption": "Brezilya Folkloru",
  "quests.festabrasil_25.1746710943644.chaincaption": "Haziran Festivali!",
  "quests.festabrasil_25.1746711612091.completed": "İşte bu! Şimdi harika yolculuğuna başlamaya hazırsın!",
  "quests.festabrasil_25.1746711612091.desc": "Bu ülkenin doğa tarafını keşfedelim!",
  "quests.festabrasil_25.1746711612091.hint": "Gabriela'dan harika bir teklif aldın. Belki de bu maceraya başlamadan önce biraz dinlenmek iyi bir fikirdir!",
  "quests.festabrasil_25.1746711612091.name": "Brezilya'da ilk hafta: Doğa",
  "quests.festabrasil_25.1746712804045.completed": "Bu daha iyi ve harika görünüyorsun!",
  "quests.festabrasil_25.1746712804045.desc": "Bu ülkenin doğa tarafını keşfedelim!",
  "quests.festabrasil_25.1746712804045.hint": "Gabriela sizi ormana götürüyor ve en güzel yerel hayvanlardan bazılarını bulacaksınız. O parmak arası terlikler uygun değil. Bu macera için doğru kıyafetleri alın.",
  "quests.festabrasil_25.1746712804045.name": "Brezilya'da ilk hafta: Doğa",
  "quests.festabrasil_25.1746717851682.completed": "Çok güzeller, değil mi?",
  "quests.festabrasil_25.1746717851682.desc": "Bu ülkenin doğa tarafını keşfedelim!",
  "quests.festabrasil_25.1746717851682.hint": "Vahşi doğada özel hayvanlar bulmak için sabırlı olmalı ve biraz şansın olmalıdır. Ama eminim bu güzel kediyi bulacaksınız.",
  "quests.festabrasil_25.1746717851682.name": "Brezilya'da ilk hafta: Doğa",
  "quests.festabrasil_25.1746786217328.completed": "Çok eğlenceli!",
  "quests.festabrasil_25.1746786217328.desc": "Sadece terlikte...",
  "quests.festabrasil_25.1746786217328.hint": "Brezilya'da birçok dans türü bulunur ve bu da yerel halkın bir araya gelmesi için bir sebeptir. İyi ayakkabılarınızı giyin ve yeni hareketler öğrenmek için bir parti bulun!",
  "quests.festabrasil_25.1746786217328.name": "Hadi dans edelim!",
  "quests.festabrasil_25.1746787012834.completed": "Çok tatlı! \"Karamelo\" her yerde bulunabilir.",
  "quests.festabrasil_25.1746787012834.desc": "Brezilyalılar internette memler yaratmakla ünlüdür...",
  "quests.festabrasil_25.1746787012834.hint": "Bu köpek, internetteki bir meme sayesinde çok ünlü oldu. Sosyal medyanız için birlikte dans etme memesini yeniden yaratmak için onu bulmalı mısınız?",
  "quests.festabrasil_25.1746787012834.name": "Meme Kültürü",
  "quests.festabrasil_25.1746788746138.completed": "Aferin!",
  "quests.festabrasil_25.1746788746138.desc": "Bu ülkenin doğa tarafını keşfedelim!",
  "quests.festabrasil_25.1746788746138.hint": "Bu Fauna Sandığında vahşi bir şey saklanıyor! İçinde ne olduğunu öğrenmek için onu odanıza yerleştirin!",
  "quests.festabrasil_25.1746788746138.name": "Brezilya'da ilk hafta: Doğa",
  "quests.festabrasil_25.1746789171932.completed": "Oraya çok kısa sürede vardın!",
  "quests.festabrasil_25.1746789171932.desc": "Farklı bir toplu taşıma türü deneyin",
  "quests.festabrasil_25.1746789171932.hint": "Gabriela seni bir plaj gününe davet etti ama otelin biraz uzak ve yoğun saat. Motosiklet taksisi denemeye ne dersin?",
  "quests.festabrasil_25.1746789171932.name": "Plaja ulaşmak",
  "quests.festabrasil_25.1746789831385.completed": "Ne güzel zamanlar!",
  "quests.festabrasil_25.1746789831385.desc": "Okyanus kenarında biraz eğlenelim.",
  "quests.festabrasil_25.1746789831385.hint": "Gabi seni plajda bekliyor. En iyi plaj kıyafetini giy, okyanus kenarında ol.",
  "quests.festabrasil_25.1746789831385.name": "Plaj zamanı!",
  "quests.festabrasil_25.1746789926395.completed": "Güzel bir çiçek ortaya çıktı!",
  "quests.festabrasil_25.1746789926395.desc": "Bu ülkenin doğa tarafını keşfedelim!",
  "quests.festabrasil_25.1746789926395.hint": "Bu sandık gizemle filizleniyor. Onu odanıza koyun ve ne açtığını görün!",
  "quests.festabrasil_25.1746789926395.name": "Brezilya'da ilk hafta: Doğa",
  "quests.festabrasil_25.1746790254741.completed": "Bu kadar çok yemekten sonra, belki biraz yürümek iyi olur!",
  "quests.festabrasil_25.1746790254741.desc": "Gabriela ve sen açsın!",
  "quests.festabrasil_25.1746790254741.hint": "Brezilya'da plajda neredeyse her şeyi satın alabilirsiniz. Yerel atıştırmalıklar deneyelim.",
  "quests.festabrasil_25.1746790254741.name": "Hadi bir lokma yiyelim!",
  "quests.festabrasil_25.1746790524293.completed": "Harika!",
  "quests.festabrasil_25.1746790524293.desc": "Gökyüzünde bir tablo gibi!",
  "quests.festabrasil_25.1746790524293.hint": "Plajdaki gün batımları çok güzel. Yürüyüş yolunun önünden geçip, günün gecenin başlaması için alan verdiği anın tadını çıkarın.",
  "quests.festabrasil_25.1746790524293.name": "Plajda gün batımı",
  "quests.festabrasil_25.1746790719513.completed": "Çok güzeller, değil mi?",
  "quests.festabrasil_25.1746790719513.desc": "Bu ülkenin doğa tarafını keşfedelim!",
  "quests.festabrasil_25.1746790719513.hint": "Bu sandık egzotik çiçeklerle dolu! Görevleri tamamlamak için üzerine tıklayın.",
  "quests.festabrasil_25.1746790719513.name": "Brezilya'da ilk hafta: Doğa",
  "quests.festabrasil_25.1746791314663.completed": "Harika!",
  "quests.festabrasil_25.1746791314663.desc": "Biraz sakinleşelim...",
  "quests.festabrasil_25.1746791314663.hint": "Gabi seni birkaç arkadaşıyla bekliyor ve hava çok sıcak. Neden herkesi dondurmaya davet etmiyorsun?",
  "quests.festabrasil_25.1746791314663.name": "Burada çok sıcak...",
  "quests.festabrasil_25.1746791769765.completed": "Görev tamamlandı! Orman şelalesinin sırları senin!",
  "quests.festabrasil_25.1746791769765.desc": "Bu ülkenin doğa tarafını keşfedelim!",
  "quests.festabrasil_25.1746791769765.hint": "Güçlü Iguazu Şelaleleri mutlaka görülmesi gereken bir yer! Orman şelalesine dokunun ve içinde saklı sırları keşfedin!",
  "quests.festabrasil_25.1746791769765.name": "Brezilya'da ilk hafta: Doğa",
  "quests.festabrasil_25.1746792202020.completed": "Harika iş! Hayvanların güvenini kazandın.",
  "quests.festabrasil_25.1746792202020.desc": "Bu ülkenin doğa tarafını keşfedelim!",
  "quests.festabrasil_25.1746792202020.hint": "Seyahatleriniz sırasında her zaman elinizde biraz meyve veya sebze bulundurun. Orman hayvanları bir atıştırmalık için minnettar olacak.",
  "quests.festabrasil_25.1746792202020.name": "Brezilya'da ilk hafta: Doğa",
  "quests.festabrasil_25.1746792428386.completed": "Bazı yerel halk tarafından evlat edinildin!",
  "quests.festabrasil_25.1746792428386.desc": "Arkadaşlık her şeydir!",
  "quests.festabrasil_25.1746792428386.hint": "Brezilya'da arkadaş edinmek oldukça kolay. Burada olduğunda yeni arkadaşlar edinmeye ne dersin?",
  "quests.festabrasil_25.1746792428386.name": "Yeni arkadaşlar edinmek",
  "quests.festabrasil_25.1746792812578.completed": "Ne kadar çok sevgi!",
  "quests.festabrasil_25.1746792812578.desc": "Öpücükler, öpücükler ve daha fazla öpücük.",
  "quests.festabrasil_25.1746792812578.hint": "Burada biriyle tanıştığınızda, öpücük vermek ve almak çok yaygındır. Bazı yerlerde sadece bir tane, bazılarında iki öpücük veriyorlar ve bu da 3 öpücüğe kadar çıkabiliyor. Bu yerel geleneğe teslim olmak nasıl olur?",
  "quests.festabrasil_25.1747229671557.completed": "Yolculuğun tadını çıkarın!",
  "quests.festabrasil_25.1747229671557.desc": "Minibüs seni oraya götürmesi için bekliyor!",
  "quests.festabrasil_25.1747229671557.hint": "Bu hafta Gabi seni küçük bir kasaba yakınlarındaki amcasının çiftliğine davet etti. Çabuk ol, minibüs seni oraya götürmek için bekliyor!",
  "quests.festabrasil_25.1747229671557.name": "Kırsal Alanı Keşfetmek",
  "quests.festabrasil_25.1747231107646.completed": "Onları dinlemeye hazır mısın?",
  "quests.festabrasil_25.1747231107646.desc": "Bağ ateşini aşalım ve bazı hikayeler dinleyelim.",
  "quests.festabrasil_25.1747231107646.hint": "Ateşin yanında iyi folklor ve çiftlik hikayeleri dinlemek için bir yer al.",
  "quests.festabrasil_25.1747231107646.name": "Kamp ateşi hikayeleri",
  "quests.festabrasil_25.1747233119902.completed": "Çok güzel!",
  "quests.festabrasil_25.1747233119902.desc": "Güzel bir çiçek oldu...",
  "quests.festabrasil_25.1747233119902.hint": "Naiá, Jaci'ye (ay) aşıktı. Ne yazık ki, nehirdeki Jaci'nin yansımasına ulaşmaya çalışırken hayatını kaybetti. Jaci ona hayranlık duydu ve onu güzel bir çiçeğe dönüştürdü. Birini bulabilir misin?",
  "quests.festabrasil_25.1747233119902.name": "Naiá & Jaci",
  "quests.festabrasil_25.1747234050720.completed": "Çok yakışıklı!",
  "quests.festabrasil_25.1747234050720.desc": "O dışarıda...",
  "quests.festabrasil_25.1747234050720.hint": "Efsanelerin doğru olup olmadığını kontrol et ve Boto Rosa'yı bul. Otelin çevresindeki bir partide olmalı.",
  "quests.festabrasil_25.1747234050720.name": "Bu gece Full MOon...",
  "quests.festabrasil_25.1747729608266.completed": "Muhteşem!",
  "quests.festabrasil_25.1747729608266.desc": "Çok güzel ve şarkı söylemesi hipnotize edici.",
  "quests.festabrasil_25.1747729608266.hint": "Denizkızı görünümü denemeye ne dersin?",
  "quests.festabrasil_25.1747729608266.name": "Denizkızı Iara",
  "quests.festabrasil_25.1747731031522.completed": "Bunu beklemiyordu!",
  "quests.festabrasil_25.1747731031522.desc": "Onu tuzağa düşürelim...",
  "quests.festabrasil_25.1747731031522.hint": "Saci yaramazlığı ile bilinir. Büyülü şapkasını çalabilir ya da tuzağa düşürebilirsin. Sadece bir şişeye ihtiyacın var. Bir tane bul!",
  "quests.festabrasil_25.1747731031522.name": "Saci-Pererê",
  "quests.festabrasil_25.1747733272352.completed": "Çok korkutucu!",
  "quests.festabrasil_25.1747733272352.desc": "Tarlaların savunucusu.",
  "quests.festabrasil_25.1747733272352.hint": "O, her yerde gözleri olan ve tarlaları suç yangınlarından koruyan alevli bir yılan. Onu tarlalarda bulabilir misin?",
  "quests.festabrasil_25.1747733272352.name": "Boitatá",
  "quests.festabrasil_25.1747735898790.completed": "Ah, söylemeyi unuttum, ayakları tam tersi, peşinden gitmeye çalışanları kandırmak için. Bu yüzden onu bulamadın.",
  "quests.festabrasil_25.1747735898790.desc": "Ormanın Koruyucusu",
  "quests.festabrasil_25.1747735898790.hint": "Birçok kişi onu ormanda bulmaya çalıştı ama çoğu başaramadı. Peki ya onun ayak izlerini takip edip, başkalarının yapamadığını yapıp yapamayacağını görebilirsin?",
  "quests.festabrasil_25.1747737479063.completed": "Tatlı rüyalar!",
  "quests.festabrasil_25.1747737479063.desc": "... Yoksa Cuca seni armaya gelir!",
  "quests.festabrasil_25.1747737479063.hint": "O kötü ve kötü davranan çocukları sevmez. En kısa sürede uyuyacak bir yer bulmak daha iyi!",
  "quests.festabrasil_25.1747737479063.name": "Uyu küçük bebeğim...",
  "quests.festabrasil_25.1747738590563.completed": "Hediyenizi ona teslim etmeyi unutmayın, yoksa büyük bir sorunla karşılaşırsınız!",
  "quests.festabrasil_25.1747738590563.desc": "Hediyeleri sever...",
  "quests.festabrasil_25.1747738590563.hint": "Matinta Perera genellikle hediyelerle karşılık verir. Ona bir şey verip bir iyilik isteyebileceğin bir şey bul.",
  "quests.festabrasil_25.1747738590563.name": "Martinta Perera",
  "quests.festabrasil_25.1747754142320.completed": "Harika görünüyorsun!",
  "quests.festabrasil_25.1747754142320.desc": "Hadi bu özel güne uygun giyinelim!",
  "quests.festabrasil_25.1747754142320.hint": "Değişmen gerekiyor, parti başlamak üzere!",
  "quests.festabrasil_25.1747754142320.name": "Partiye giyin!",
  "quests.festabrasil_25.1747813679947.completed": "Geri dönüş mesajınız var mı?",
  "quests.festabrasil_25.1747813679947.desc": "Bu \"Festa Junina\" geleneğine katıl...",
  "quests.festabrasil_25.1747813679947.hint": "Bu partideki aktivitelerden biri, birine bir tür aşk mektubu yazıp şık postacıdan onu teslim etmesini istemek. Kim olumlu bir mesaj içeren bir not almayı sevmez ki, değil mi? Eğlenceye katılın!",
  "quests.festabrasil_25.1747813679947.name": "Fancy Mail",
  "quests.festabrasil_25.1747814316428.completed": "Harika! Harika görünüyor!",
  "quests.festabrasil_25.1747814316428.desc": "\"Festa Junina\" partisini hazırlayalım!",
  "quests.festabrasil_25.1747814316428.hint": "Gabi, mahalle partisini hazırlamasına yardım etmeni istedi. Festa Fenerleri ve Festa Bunting'i asmaya başlar mısınız lütfen?",
  "quests.festabrasil_25.1747814316428.name": "Parti Zamanı!",
  "quests.festabrasil_25.1747816031455.completed": "Çok teşekkür ederim!",
  "quests.festabrasil_25.1747816031455.desc": "O kabin nerede?",
  "quests.festabrasil_25.1747816031455.hint": "Görünüşe göre kimse balık tutma kabini bulamıyor. Bulmaya yardım eder misiniz lütfen?",
  "quests.festabrasil_25.1747816031455.name": "Yardım etmek",
  "quests.festabrasil_25.1747816677435.desc": "Sıra sende!",
  "quests.festabrasil_25.1747816677435.hint": "Öpüşme kabinde birinin orada olması gerekiyor. Bir süre kapatabilir misin lütfen?",
  "quests.festabrasil_25.1747816677435.name": "Yardım etmek",
  "quests.festabrasil_25.1747817312815.completed": "Lezzetli!",
  "quests.festabrasil_25.1747817312815.desc": "Patlamış mısır dağıtıyorum!",
  "quests.festabrasil_25.1747817312815.hint": "Patlamış mısır standına bakabilir misin? İnsanlar patlamış mısırlarını almak için sırada bekliyor!",
  "quests.festabrasil_25.1747817312815.name": "Yardım etmek",
  "quests.festabrasil_25.1747819228189.completed": "Çok güzel!",
  "quests.festabrasil_25.1747819228189.desc": "\"Festa Junina\"da mutlaka bir şey var!",
  "quests.festabrasil_25.1747819228189.hint": "Partiyi bitirmenin en iyi yolu ateşin yanında olmaktır. Bulun ve alevlere bakarak anın tadını çıkarın!",
  "quests.festabrasil_25.1747819228189.name": "Parti Ateşi",
  "quests.festabrasil_25.1747819745280.completed": "Çok eğlenceli!",
  "quests.festabrasil_25.1747819745280.desc": "Dans \"Quadrille\"",
  "quests.festabrasil_25.1747819745280.hint": "Ayakkabılarınızı hazırlayın ve \"Quadrilha\" dansına katılın!",
  "quests.festabrasil_25.1747819745280.name": "Hadi dans edelim!",
  "quests.festabrasil_25.name": "Gerçek Brezilya'yı keşfedin!",
  "quests.festabrasil_25pride.1747907892711.chaincaption": "Gururu Kutlamak",
  "quests.festabrasil_25pride.1747907892711.chaininfo": "Çeşitliliği kutlayalım!",
  "quests.festabrasil_25pride.1747907927145.desc": "Çeşitliliği kutlayalım!",
  "quests.festabrasil_25pride.1747907927145.hint": "São Paulo, Avenida Paulista'da dünyanın en büyük Onur Geçitlerinden birine ev sahipliği yapmaktadır. Partiye katıl!",
  "quests.festabrasil_25pride.1747907927145.name": "Onur zamanı!",
  "quests.festabrasil_25pride.1747908217137.completed": "Renklerine bayıldım!",
  "quests.festabrasil_25pride.1747908217137.desc": "Bayrak dağıtıyorum!",
