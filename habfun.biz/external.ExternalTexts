  "quests.VIPTutorials.blow_kisses.completed": "Hoş ve şık! Mabbo HK olmaya devam etmek istiyorsan Mağaza'dan üyelik satın alabilirsin!",
  "quests.VIPTutorials.blow_kisses.desc": "Aşkı yay. İşte HK olmak böyle bir şey,",
  "quests.VIPTutorials.blow_kisses.hint": "Bu görevi tamamlamak için 10 Mabbo'e öpücük yolla.",
  "quests.VIPTutorials.blow_kisses.name": "AŞKI YAY!",
  "quests.VIPTutorials.chaincaption": "HK Görevleri",
  "quests.VIPTutorials.chaininfo": "HK görevlerini üstlenebilecek kadar seçkin biri misin?",
  "quests.VIPTutorials.create_vip_room.completed": "Harika. Artık gelecek HK partilerin için yeterli alana sahipsin! HK'lar, odalarını özelleştirmek için kullanabilecekleri birkaç yeni düzene erişebilir.",
  "quests.VIPTutorials.create_vip_room.desc": "Öncelikle düzgün bir HK odaya ihtiyacın var.",
  "quests.VIPTutorials.create_vip_room.hint": "Yeni bir oda oluşturmak için Odalara ve Ben sekmesine tıkla ve bu görevi tamamlamak için bir HK yerleşim düzeni seç.",
  "quests.VIPTutorials.create_vip_room.name": "OLAYI BÜYÜT",
  "quests.VIPTutorials.dance_pogo_mogo.completed": "Piksellerini dök! Salla! Genç bir Vaslav Nijinsky gibi mi yoksa Anna Pavlova gibi mi dans edersin? Onlar zamanın ünlü baletleriydi.",
  "quests.VIPTutorials.dance_pogo_mogo.desc": "Belki de dans hareketleri çalışmalısın?",
  "quests.VIPTutorials.dance_pogo_mogo.hint": "Bu görevi tamamlamak için ilk önce avatarına daha sonra da dansa tıklayarak Pogo Mogo dansı yap.",
  "quests.VIPTutorials.dance_pogo_mogo.name": "PİKSELLERİNİ DÖK",
  "quests.VIPTutorials.drop_vip_furni.completed": "Paha biçilemez! Gerçekten de odayı toplu tutuyor, değil mi? HK'lar üye oldukları her ay seçkin bir Mobi alıyor, oldukça zarif bir koleksiyon!",
  "quests.VIPTutorials.drop_vip_furni.desc": "Bunun için lüks bir dokunuşa ne dersin?",
  "quests.VIPTutorials.drop_vip_furni.hint": "Mağazayı aç ve HK hediyeni almak için HK Hediyeleri sayfasına git. Daha sonra Eşyalarım arasında bulabilirsin. Bu görevi tamamlamak için malzemeyi odana yerleştir.",
  "quests.VIPTutorials.drop_vip_furni.name": "DEKORE ET",
  "quests.VIPTutorials.laugh.completed": "Evet, işte bu dans oldukça komikti! Bir HK olarak fazladan eylemlere sahipsin, yakın Mabbo arkadaşlarına bir öpücük bile gönderebilirsin!",
  "quests.VIPTutorials.laugh.desc": "Komik dans ediyor, bir kahkaha patlat.",
  "quests.VIPTutorials.laugh.hint": "Bu görevi tamamlamak için kahkaha at; kahkaha atmak için önce Mabbo'na daha sonra da Eylemler'e tıkla.",
  "quests.VIPTutorials.laugh.name": "HAHA!",
  "quests.VIPTutorials.name": "HK Görevleri",
  "quests.VIPTutorials.wear_a_crown.completed": "Artık sana bundan böyle \"Ekselansları\" mı dememiz gerekiyor?",
  "quests.VIPTutorials.wear_a_crown.desc": "Zengin görün... \"Gösterişli\" bir şeyler giy.",
  "quests.VIPTutorials.wear_a_crown.hint": "Bir HK olarak bir sürü aksesuara erişme hakkına sahipsin. Bu görevi tamamlamak için bir taç giy.",
  "quests.VIPTutorials.wear_a_crown.name": "SEN KRALİYET AİLESİNDEN GELİYORSUN!",
  "quests.VIPTutorials.wear_white_shirt.completed": "Harika! Parlak, ışıl ışıl ve bembeyaz! Senden daha şık bir Mabbo daha görmemiştim!",
  "quests.VIPTutorials.wear_white_shirt.desc": "Hoşgeldin etkinliğinde beyaz parti teması hakim!",
  "quests.VIPTutorials.wear_white_shirt.hint": "VIP'ler birçok ekstra kıyafet ve renge ulaşabilir! Elbiselerini değiştirmek için Mabbo'na tıkla ve bu görevi tamamlamak için HK beyazında bir HK gömleği giy.",
  "quests.VIPTutorials.wear_white_shirt.name": "N'ABER GÜZELLİK?",
  "quests.VIP_Parties_1.1348497018682.chaincaption": "Parti Giriş Kartı",
  "quests.VIP_Parties_1.1348497018682.chaininfo": "HC partilerine giri? kazanmak için bu görevleri tamamla!",
  "quests.VIP_Parties_1.Find_Style_1.completed": "Bravo! Ama sanırım bunun modası biraz geçmiş?",
  "quests.VIP_Parties_1.Find_Style_1.desc": "Her HC'nin giysilerinde güçlü bir ki?isellik vard?r. Senin de olsun!",
  "quests.VIP_Parties_1.Find_Style_1.hint": "Gardırobunu kontrol et ve seni gerçek bir Versay Kralı/Kraliçesi yapacak 2 gizli aksesuar bul!",
  "quests.VIP_Parties_1.Find_Style_1.name": "TARZINI BUL PT I",
  "quests.VIP_Parties_1.find_your_style_2.completed": "Fena değil ancak kürk şapka yat partisi için biraz fazla sıcak olabilir.",
  "quests.VIP_Parties_1.find_your_style_2.desc": "Ya bir çeşit Rus Prensi olsan ne olacaktı?",
