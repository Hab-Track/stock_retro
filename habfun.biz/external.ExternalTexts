  "landing.view.suncity19dress.button": "Nadir olanı gör!",
  "landing.view.suncity19dress.header": "NADİR Kelebek Elbise!",
  "landing.view.suncity19easelltd.body": "Bu easel LTD çok sınırlı sayıda olanlardan biri, bu yüzden kaçırmayın!",
