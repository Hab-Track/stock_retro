  "quests.VIP_Parties_1.find_your_style_2.name": "TARZINI BUL PT 2",
  "quests.VIP_Parties_1.find_your_syle_3.completed": "Şıklık ve tarzın mükemmel kombinasyonu!",
  "quests.VIP_Parties_1.find_your_syle_3.desc": "Zarif milyarderden ne haber?",
